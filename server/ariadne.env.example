# Ariadne deployment settings. Copy to `ariadne.env` beside run-ariadne.sh and
# edit; the script reads it if present and uses these defaults if not.
#
# `ariadne.env` holds a secret. It is created 0600 and must not be copied to a
# share or committed anywhere.

# ── The two keys ─────────────────────────────────────────────────────────────
#
# ARIADNE_SECRET seals a project's stored DATABASE PASSWORD (AES-GCM). There is
# deliberately no default: a default would be the same key on every deployment,
# which is not a key. Leave it blank and the server runs normally — the one
# thing it refuses is STORING a password, and it says which variable to set. It
# never falls back to plaintext.
#
# ⚠ IT MUST SURVIVE A REDEPLOY. Change it and every stored password becomes
# undecryptable, which presents as a schema import failing to authenticate and
# looks like a database problem. run-ariadne.sh generates one on first run and
# writes it here rather than letting you lose it.
ARIADNE_SECRET=

# The key a database ADAPTER expects, sent as X-Adapter-Key. Only needed if you
# point Ariadne at an Oracle (or other adapter-backed) database. Blank sends an
# empty key and the adapter answers 401 saying so, which is the adapter's
# decision to make rather than this side's.
ARIADNE_ADAPTER_KEY=

# ── Where the data lives ─────────────────────────────────────────────────────
#
# Both MUST be outside any directory you would ever delete to "start clean",
# and both must survive a redeploy.

# The database's files.
ARIADNE_DB_DATA=/var/lib/ariadne/db

# The SOURCE STORE — one git repository per indexed project, written by the
# `ariadne index` command from a client. Treat it exactly as carefully as the
# database: it holds the source every graph describes, and losing it leaves
# each graph describing code nobody can reproduce.
ARIADNE_SOURCE=/var/lib/ariadne/source

# ── Ports on the host ────────────────────────────────────────────────────────
#
# 8193 is the one clients use: ariadne-web serves the UI and proxies /api and
# /ws to the API. 8192 is the API direct and does NOT need to be reachable from
# anywhere but this box — firewall it off if you like, nothing will break.
ARIADNE_WEB_PORT=8193
ARIADNE_API_PORT=8192

# The stock Postgres image. Pulled once from docker.io unless already present;
# see DEPLOYMENT.md for the fully offline route.
ARIADNE_PG_IMAGE=docker.io/pgvector/pgvector:pg16

# Whether the containers come back on their own — OFF by default, because
# autostart is a decision rather than a detail. Set it to `unless-stopped` if
# you want the stack to survive a reboot; it also needs lingering enabled for
# the user and podman's restart unit active, neither of which this script
# touches.
ARIADNE_RESTART=no
